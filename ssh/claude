apiVersion: v1
kind: Pod
metadata:
  name: nginx
  labels:
    app: second
spec:
  containers:
    - name: nginx
      image: nginx:1.27
      ports:
        - containerPort: 80

apiVersion: v1
kind: Service
metadata:
  name: second-svc
spec:
  type: ClusterIP
  selector:
    app: second        # doit correspondre au label du pod
  ports:
    - port: 80         # port exposé par le service
      targetPort: 80   # port du conteneur
